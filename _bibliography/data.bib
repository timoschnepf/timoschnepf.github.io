@Article{Schnepf2022,
  author  = {Johanna Binnewitt and Timo Schnepf},
  title   = {Wortliste zur Assoziation ökologischer Nachhaltigkeit (WAoeN)},
  journal = {BIBB},
  year    = {2022},
  preview={bibb_logo.png},
  html={https://www.bibb.de/de/153062.php},
  abstract={The WAoeN is a german word list consisting of 1800 keywords (single-word and multi-word expressions) associated with 
  environmental sustainability. Each term was assigned a semi-metric scale value between one and five. 
  This operationalises the degree of association with the theoretical construct "ecological sustainability". 
  The word list is based on a publicly available word list from the Federal Environment Agency (UBA/BMU 2021). 
  It was enriched with the help of a Word2Vec model and GermaNet.}
  }

@Article{Schnepf2023,
  author  = {Timo Schnepf},
  title   = {ARD Tagesschau/Tagesthemen Subtitles},
  year    = {2023},
  preview={tagesschau_logo.jpg},
  html={https://www.tagesschau.de/archiv},
  abstract={The ARD Tagesschau/Tagesthemen Subtitles is a full collection of all digital subtitles from the German news programs "20 Uhr Tagesschau" and "Tagesthemen". 
  It was provided by the ARD in cooperation with the NDR and is available as SRT, STL files and as a feather dataset. 
  The dataset contains all subtitles from 01.11.2014 to 21.03.2023. The corpus is not publicly available, but can be requested.}
  }

@Article{Schnepf2020,
  author  = {Timo Schnepf},
  title   = {Online Marketplace Apartment Seekers},
  year    = {2020},
  preview={kleinanzeigen_logo.jpg},
  html={https://www.youtube.com/watch?v=AM2RGedTqFA},
  abstract={The 'Online Marketplace Apartment Seekers' dataset is a collection of around 20.000 appartment seekers' application texts 
  from the online marketplace 
  'Kleinanzeigen.de' (formerly 'Ebay Kleinanzeigen'). The data were scraped between august 2019 until may 2020. The appartment seekers application text
  and further metadata are available in a CSV file. The data are only available upon request for research purposes and not for commercial use.}
  }